<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 
    CA1416: Validate platform compatibility
    Suppress CA1416 warnings for Windows-specific TFMs (e.g., net10.0-windows) 
    where Windows-only APIs are expected and acceptable.
    
    This uses Directory.Build.targets (not props) because TFM-conditional properties
    need TargetFramework to be defined, which happens AFTER Directory.Build.props
    is imported but BEFORE Directory.Build.targets is imported.
    
    Non-windows TFMs (e.g., net10.0, net8.0) will still get CA1416 warnings to catch
    real portability issues.
  -->
  <PropertyGroup>
    <NoWarn Condition="$(TargetFramework.Contains('-windows'))">$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
